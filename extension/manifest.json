{
  "manifest_version": 3,
  "name": "Jev Blocker",
  "version": "0.1.0",
  "description": "Blocks ads, trackers and redirect chains, then uses Jev to judge the elements a blocklist cannot.",
  "minimum_chrome_version": "116",

  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.typesafe.ai/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Jev Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "src/options.html",

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      { "id": "filters-01", "enabled": true, "path": "rules/filters-01.json" },
      { "id": "filters-02", "enabled": true, "path": "rules/filters-02.json" },
      { "id": "filters-03", "enabled": true, "path": "rules/filters-03.json" },
      { "id": "filters-04", "enabled": true, "path": "rules/filters-04.json" },
      { "id": "filters-05", "enabled": true, "path": "rules/filters-05.json" },
      { "id": "filters-06", "enabled": true, "path": "rules/filters-06.json" },
      { "id": "filters-07", "enabled": true, "path": "rules/filters-07.json" },
      { "id": "filters-08", "enabled": true, "path": "rules/filters-08.json" },
      { "id": "filters-09", "enabled": true, "path": "rules/filters-09.json" },
      { "id": "filters-10", "enabled": true, "path": "rules/filters-10.json" },
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "redirects", "enabled": true, "path": "rules/redirects.json" },
      { "id": "tracking_params", "enabled": true, "path": "rules/tracking-params.json" }
    ]
  }
}
